// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "debugger": {
    "button": false
  },
  "format_on_save": "on",
  "edit_predictions": {
    "provider": "zed",
  },
  "diff_view_style": "split",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "right",
  },
  "agent": {
    "auto_compact": {
      "threshold": "90%",
    },
    "default_model": { "provider": "zed.dev", "model": "claude-sonnet-5" },
    "dock": "right",
    "favorite_models": [],
    "inline_assistant_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-5",
    },
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "right",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
      },
      "type": "registry",
    },
  },
  "base_keymap": "SublimeText",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "One Dark",
  },
  "languages": {
    "CSS": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "npx",
          "arguments": [
            "stylelint",
            "--fix",
            "--stdin",
            "--stdin-filename",
            "{buffer_path}",
          ],
        },
      },
    },
    "HTML+ERB": {
      "tab_size": 2,
      "language_servers": ["herb", "ruby-lsp"],
      "formatter": {
        "external": {
          "command": "npm",
          "arguments": ["run", "--silent", "herb:format"],
        },
      },
    },
    "Ruby": {
      "language_servers": ["ruby-lsp"],
    },
  },
  "lsp": {
    "ruby-lsp": {
      "settings": {
        "use_bundler": false,
      },
    },
  },
}
