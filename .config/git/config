[advice]
    skippedCherryPicks = false

[alias]
    adp = add -p
    alias = config --get-regexp ^alias\\.
    amend = commit --amend
    ap = add --patch
    autosquash = rebase -i --autosquash
    behind = "!f() { git branch | sed \"s/\\\\*//\" | while read branch; do count=$(git rev-list --count $branch..main); printf \"%-4s commits behind main %s\\n\" \"$count\" \"$branch\"; done | sort -nr; }; f"
    br = branch -vv
    brr = branch -vv --sort=-committerdate
    ci = commit -v
    co = checkout
    fixup = commit --fixup
    fpush = push --force-with-lease
    nomend = commit --amend --no-edit
    pick = cherry-pick
    rbi = rebase -i
    rbim = rebase -i main
    remain = !git fetch origin && git rebase origin/main
    review = show main.. --reverse
    slog = log --pretty=oneline --abbrev-commit
    squash = commit --squash
    st = status --short --branch
    staged = diff --cached
    stf = !git status -s | cut -c4- | xargs
    sum = log --pretty=oneline --abbrev-commit --name-status --reverse
    summ = log --pretty=oneline --abbrev-commit --name-status --reverse main..
    sw = switch
    sw- = switch -
    swc = switch --create
    todo = !git diff main.. | grep "^+.*TODO"
    undo = reset HEAD~
    w = worktree
    wadd = worktree add
    wip = commit --message=WIP
    wls = worktree list

[color]
    ui = auto

[color "diff"]
    new = brightgreen bold
    old = red dim

[commit]
    verbose = true

[core]
    editor = nvim
    pager = delta

[credential "https://git.heroku.com"]
    provider = generic

[fetch]
    prune = true

[filter "lfs"]
    clean = git-lfs clean -- %f
    process = git-lfs filter-process
    required = true
    smudge = git-lfs smudge -- %f

[init]
    defaultBranch = main

[interactive]
    diffFilter = delta --color-only

[merge]
    conflictStyle = zdiff3

[push]
    default = current

[rebase]
    autosquash = true
    updateRefs = true

[user]
    email = todd@solerasoftware.com
    name = Todd Siegel

[includeIf "gitdir:~/projects/scipinion"]
    path = ~/.config/git/scipinion-config
[rerere]
	enabled = true
