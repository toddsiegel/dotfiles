#!/usr/bin/env bash
# List packages I installed after the OS install, grouped by source repo.
set -euo pipefail

pkgs=$(comm -23 <(apt-mark showmanual | sort -u) \
                <(gzip -dc /var/log/installer/initial-status.gz | sed -n 's/^Package: //p' | sort -u))

[[ -z $pkgs ]] && { echo "No user-installed packages found."; exit 0; }

apt-cache policy $pkgs | awk '
  /^[^ ]/     { pkg = $1; sub(/:$/, "", pkg); next }
  /\*\*\*/    { grab = 1; next }
  grab        { src = ($2 ~ /^\//) ? "local / no repo" : $2
                print src "\t" pkg; grab = 0 }
' | sort | awk -F'\t' '$1 != prev { printf "\n%s\n", $1; prev = $1 } { print "  " $2 }'
